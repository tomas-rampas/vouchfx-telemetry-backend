<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Vouchfx.Telemetry.Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link bootstrap.sql and its schema-evolution companion as embedded resources so
         DbBootstrapper can run them as separate commands/transactions, followed by
         configuration-aware partition seeding in a third transaction. -->
    <EmbeddedResource Include="..\..\deploy\sql\bootstrap.sql" LogicalName="bootstrap.sql" />
    <EmbeddedResource Include="..\..\deploy\sql\bootstrap-schema-evolution.sql" LogicalName="bootstrap-schema-evolution.sql" />
  </ItemGroup>

</Project>
